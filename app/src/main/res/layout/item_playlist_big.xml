<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tool="http://schemas.android.com/tools"
    android:layout_marginHorizontal="@dimen/pad_4"
    android:layout_marginBottom="@dimen/padding_16"
    android:background="@color/screen_color">

    <ImageView
        android:id="@+id/playlistCover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="h,1:1"
        tool:src="@drawable/placeholder_trackcover"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/playlistName"
        android:layout_width="match_parent"
        android:layout_height="@dimen/padding_16"
        android:layout_marginTop="@dimen/pad_4"
        style="@style/PlaylistItemText"
        tool:text="@string/new_playlist_name_edittext"
        app:layout_constraintTop_toBottomOf="@+id/playlistCover"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/playlistSize"
        android:layout_width="match_parent"
        android:layout_height="@dimen/padding_16"
        style="@style/PlaylistItemText"
        tool:text="@string/zero_current_timing"
        app:layout_constraintTop_toBottomOf="@id/playlistName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>