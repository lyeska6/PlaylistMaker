<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/height_60"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tool="http://schemas.android.com/tools"
    android:background="@color/screen_color">

    <ImageView
        android:id="@+id/playlistCover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="w,1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="@dimen/pad_12"
        android:layout_marginVertical="@dimen/pad_8"
        tool:src="@drawable/placeholder_trackcover"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/playlistCover"
        android:layout_marginStart="@dimen/pad_8">

        <TextView
            android:id="@+id/playlistName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tool:text="@string/search"
            android:fontFamily="@font/ys_display_regular"
            android:layout_weight="400"
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/big_text"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/playlistSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tool:text="@string/zero_current_timing"
            android:fontFamily="@font/ys_display_regular"
            android:textFontWeight="400"
            android:textSize="@dimen/text_size_11"
            android:textColor="@color/small_text"
            android:maxLines="1"
            />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>